{
  "audio": "input/vocals.wav",
  "lyrics": "input/lyrics.txt",
  "output": "output/song.mp4",
  "config": "output/test.config.json",
  "render": false,
  "template": "",
  "resolution": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "encoder": "cpu",
  "transcription": {
    "model": "small",
    "separateVocals": false,
    "wordAlign": true,
    "demucsModel": "htdemucs",
    "leadSeconds": 0,
    "holdSeconds": 0,
    "interpolateWords": true
  },
  "wordDisplay": {
    "mode": "cumulative",
    "hold": "next-word",
    "spacing": 0.25
  },
  "exportRange": {
    "start": 0,
    "end": null
  },
  "viz": {
    "enabled": false,
    "mode": "wave",
    "position": "bottom",
    "colors": [
      "#00e5ff"
    ],
    "reflection": false
  }
}