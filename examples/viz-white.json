{
  "title": "Music Viz (JSON) Demo",
  "theme": "dark",
  "audio": "input/demo.mp3",
  "resolution": { "width": 1280, "height": 720, "fps": 24 },
  "typography": {
    "font": "Impact",
    "color": "#e9edf2",
    "animation": "fade_up"
  },
  "background": { "preset": "industrial" },
  "musicViz": {
    "enabled": true,
    "mode": "bars",
